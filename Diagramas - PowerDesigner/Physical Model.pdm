<c:Triggers>
<o:Trigger Id="o84">
<a:ObjectID>8688CE75-668C-4A5A-A9B3-BB82A56898A7</a:ObjectID>
<a:Name>trg_io_insertar_detalle_factura</a:Name>
<a:Code>trg_io_insertar_detalle_factura</a:Code>
<a:Text>create  trigger [dbo].[trg_io_insertar_detalle_factura]
on [dbo].[Detallefactura]
instead of insert
as
begin	
	--Declaración de variables
	declare @id_factura bigint;
	declare @subtotal decimal(18, 4), @total decimal(18, 4);

	declare @num_lineas tinyint = (Select COUNT(*) from inserted);

	--Calcular el subtotal y total del detalle de la factura a registrarse
	Select  @subtotal = sum(p.precio_unitario * df.cantidad),
			@total = sum(p.precio_unitario * df.cantidad * (1 + p.iva_producto/100)),
			@id_factura = df.id_factura	
	from inserted as df
		inner join Producto as p on df.id_producto = p.id_producto
	group by df.id_factura;

	--Inserción del detalle de la factura incluyendo los datos definidos en la tabla 
	--de Productos.
	Insert into Detallefactura (
		id_factura, id_producto,
		precio_unitario_detalle, iva_detalle,
		cantidad, subtotal_detalle, total_detalle
	)
	Select 
		df.id_factura as id_factura, df.id_producto as id_producto, 
		p.precio_unitario as precio_unitario, p.iva_producto as iva, 
		df.cantidad as cantidad, 
		p.precio_unitario * df.cantidad as subtotal,
		p.precio_unitario * df.cantidad * (1 + p.iva_producto/100) as total
	from inserted as df inner join Producto as p on p.id_producto = df.id_producto;
	
	--Actualizar el subtotal y total de la factura
	Update Factura set
		subtotal_factura = subtotal_factura + @subtotal,
		total_factura = total_factura + @total
	where id_factura = @id_factura;

end</a:Text>
<a:CreationDate>1718283771</a:CreationDate>
<a:Creator>USUARIO</a:Creator>
<a:ModificationDate>1718288234</a:ModificationDate>
<a:Modifier>USUARIO</a:Modifier>
<a:GlobalObjectID/>
<a:Time/>
</o:Trigger>
</c:Triggers>
